# Secrets belong only in backend/.env (ignored) or Render's environment.
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173
# Render uses one trusted proxy hop; local development uses zero.
TRUST_PROXY_HOPS=0

# Copy the Supabase SESSION pooler URL (port 5432) from Connect.
# Percent-encode special characters in the database password.
DATABASE_URL=
# Required if the server certificate is not trusted by Node's CA roots.
DATABASE_CA_CERT_BASE64=
JWT_SECRET=
JWT_ISSUER=routeshield-api
JWT_AUDIENCE=routeshield-web
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional Google Routes setup; separate from the Gemini key. See docs/google-maps-setup.md.
# Server key: restrict to Routes API and this Render service's outbound IP ranges.
GOOGLE_MAPS_SERVER_API_KEY=
# Used only by the opt-in npm run maps:check credential smoke check.
GOOGLE_MAPS_CHECK_ORIGIN=
GOOGLE_MAPS_CHECK_DESTINATION=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=evidence

# Temporary only when provisioning a moderator; remove afterward.
MODERATOR_EMAIL=
MODERATOR_PASSWORD=
MODERATOR_DISPLAY_NAME=RouteShield Moderator

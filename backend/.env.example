# RouteShield AI Backend Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (Supabase PostgreSQL Session Pooler recommended)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
DATABASE_CA_CERT_BASE64=

# Authentication (HMAC SHA-256)
JWT_SECRET=replace-with-a-secure-random-32-byte-secret-for-jwt
JWT_ISSUER=routeshield-api
JWT_AUDIENCE=routeshield-web

# Gemini Multimodal AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Supabase Storage (Private 'evidence' bucket only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=evidence

# Moderator creation script variables (Set temporarily when running scripts/create-moderator.ts)
MODERATOR_EMAIL=admin@routeshield.internal
MODERATOR_PASSWORD=SecurePassword123!
MODERATOR_DISPLAY_NAME="RouteShield Admin"

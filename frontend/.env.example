# Local: leave blank to use the Vite /api proxy -> localhost:5001.
# Vercel: set the real Render HTTPS origin, then redeploy.
VITE_API_BASE_URL=

# Optional Google Maps display key; intentionally browser-visible, website/API restricted.
# Do not put GOOGLE_MAPS_SERVER_API_KEY or GEMINI_API_KEY here.
# These settings prepare the future optional mode; they do not activate a map screen yet.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
